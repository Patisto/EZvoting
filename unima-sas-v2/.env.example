# Neon: use the POOLED connection string (host contains "-pooler") from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The super account is created on first boot if none exists.
SUPER_ADMIN_USERNAME=patrick
SUPER_ADMIN_PASSWORD=change-me-to-something-long
SUPER_ADMIN_NAME=Super Admin

# Shown in the header of public pages
BRAND_NAME=UNIMA Elections

PORT=3000
NODE_ENV=development

# Nominations are handled outside the system. Set to true to switch the old open-nominations flow back on.
ENABLE_NOMINATIONS=false
